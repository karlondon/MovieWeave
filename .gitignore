# Git ignore file for MovieWeave
# Prevents sensitive files from being committed

# SSH Keys - NEVER commit these!
pem-key/*.pem
pem-key/*.key
pem-key/*-key*
pem-key/private_key*
pem-key/.ssh/

# Environment variables with secrets
.env
.env.local
.env.*.local

# API Keys and credentials
.aws/
.aws/*
credentials
*.credentials

# Database files
*.db
*.sqlite
*.sqlite3
data/jobs_db.json
data/sessions_db.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*

# Node modules
node_modules/
toonflow/node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Temp files
data/uploads/*
data/output/*
data/temp/*
backups/

# Docker
.dockerignore
docker-compose.override.yml

# Keep structure but ignore contents
!pem-key/.gitkeep
!data/.gitkeep
!logs/.gitkeep
