# MovieWeave Environment Configuration
# Copy this file to .env and fill in your actual values

# ===== AWS CREDENTIALS =====
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_S3_BUCKET=movieweave-storage
AWS_POLLY_REGION=us-east-1

# ===== APPLICATION SETTINGS =====
APP_ENV=production
APP_NAME=MovieWeave
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# ===== SERVER SETTINGS =====
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
WORKERS=4

# ===== CORS SETTINGS =====
CORS_ORIGINS=["https://movieweave.myblognow.uk", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]

# ===== DATABASE SETTINGS =====
DATABASE_TYPE=json
JOBS_DB_FILE=data/jobs_db.json
SESSIONS_DB_FILE=data/sessions_db.json

# ===== STORAGE SETTINGS =====
UPLOAD_DIR=data/uploads
OUTPUT_DIR=data/output
TEMP_DIR=data/temp
MAX_UPLOAD_SIZE_MB=500

# ===== TOONFLOW SETTINGS =====
TOONFLOW_URL=http://localhost:10588
TOONFLOW_API_TIMEOUT=300
TOONFLOW_ENABLED=true

# ===== FREEMIUM SETTINGS =====
FREE_CONVERSIONS_PER_DAY=3
FREE_RESOLUTION=720p
PAID_RESOLUTION=1080p

# ===== PAYMENT SETTINGS (SQUARE) =====
SQUARE_ACCESS_TOKEN=your_square_access_token
SQUARE_APPLICATION_ID=your_square_app_id
SQUARE_LOCATION_ID=your_square_location_id
SQUARE_ENVIRONMENT=production
DOWNLOAD_PRICE_GBP=1.0

# ===== POLLY VOICES CONFIGURATION =====
NARRATOR_VOICE=Joanna
MALE_VOICE_1=Matthew
MALE_VOICE_2=Justin
FEMALE_VOICE_1=Ivy
FEMALE_VOICE_2=Salli
CHILD_VOICE=Kimberly

# ===== VIDEO PROCESSING =====
VIDEO_FPS=24
VIDEO_RESOLUTION=1080p
VIDEO_BITRATE=5000k
AUDIO_BITRATE=192k

# ===== ANALYTICS =====
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
SENTRY_DSN=

# ===== SECURITY =====
SECRET_KEY=your-super-secret-key-change-this-in-production
ALLOWED_HOSTS=movieweave.myblognow.uk,localhost,127.0.0.1,34.204.47.202

# ===== DOMAIN SETTINGS =====
APP_DOMAIN=movieweave.myblognow.uk
APP_PROTOCOL=https
