# SceneWeave MVP v2.0.0 - Environment Configuration

# Application Settings
APP_NAME=SceneWeave MVP
APP_VERSION=2.0.0
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=8000

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=/tmp/sceneweave/uploads
OUTPUT_DIR=/tmp/sceneweave/output
TEMP_DIR=/tmp/sceneweave/temp
LOGS_DIR=./logs
ASSETS_DIR=./backend/assets

# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# TTS Configuration
TTS_ENGINE=kokoro  # Options: "kokoro" (local) or "api" (Groq/TogetherAI)
GROQ_API_KEY=  # Optional: For cloud-based TTS fallback

# Job Management
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=3600  # 1 hour
