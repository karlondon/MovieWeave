# SceneWeave MVP v2.0.0 - Production Lightsail Deployment

# Application Settings
APP_NAME=SceneWeave MVP
APP_VERSION=2.0.0
DEBUG=False

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Production Lightsail Server
LIGHTSAIL_IP=34.204.47.202
LIGHTSAIL_DOMAIN=movieweave.myblognow.uk
LIGHTSAIL_USER=ubuntu
LIGHTSAIL_PEM_KEY=/Users/karthiksankaran/MovieWeave/pem-key/movieweave.pem

# File Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=/data/sceneweave/uploads
OUTPUT_DIR=/data/sceneweave/output
TEMP_DIR=/data/sceneweave/temp
LOGS_DIR=/data/sceneweave/logs
ASSETS_DIR=/data/sceneweave/assets

# LLM Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# TTS Configuration
TTS_ENGINE=kokoro  # Options: "kokoro" (local) or "api" (Groq/TogetherAI)
GROQ_API_KEY=  # Optional: For cloud-based TTS fallback

# Job Management
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_SECONDS=3600  # 1 hour

# AWS Configuration (Optional)
AWS_REGION=us-east-1
AWS_S3_BUCKET=movieweave-storage
